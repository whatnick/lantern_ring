    <instance moduleIdRef="NoteModuleID" modelIndex="900" path="note.fzp">
      <title>Wiring note</title>
      <text>&lt;html&gt;&lt;body style='font-family:Arial;font-size:10pt'&gt;&lt;h2&gt;Arduino Uno ArduinoISP -&gt; programming clip -&gt; Ring IR PCB&lt;/h2&gt;&lt;p&gt;GREY MISO | WHITE 3V3 VCC | BLUE SCK | PURPLE MOSI | BROWN RESET | BLACK GND&lt;br/&gt;J1 = board-top view. Right-hand links represent spring/flat contacts, NOT extra cables.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="15" y="5" z="6" width="1250" height="100"/>
        </breadboardView>
        <schematicView layer="schematicNote">
          <geometry x="15" y="5" z="6" width="1250" height="100"/>
        </schematicView>
      </views>
    </instance>
    <instance moduleIdRef="NoteModuleID" modelIndex="901" path="note.fzp">
      <title>Wiring note</title>
      <text>&lt;html&gt;&lt;body style='font-family:Arial;font-size:10pt'&gt;&lt;b&gt;HOST: Arduino Uno / ATmega328P&lt;/b&gt;&lt;br/&gt;Load File &gt; Examples &gt; 11.ArduinoISP &gt; ArduinoISP.&lt;br/&gt;D12=MISO, D11=MOSI, D13=SCK, D10=target RESET.&lt;br/&gt;Do NOT use Uno RESET or the USB-interface ICSP header.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="15" y="115" z="6" width="370" height="90"/>
        </breadboardView>
        <schematicView layer="schematicNote">
          <geometry x="15" y="115" z="6" width="370" height="90"/>
        </schematicView>
      </views>
    </instance>
    <instance moduleIdRef="NoteModuleID" modelIndex="902" path="note.fzp">
      <title>Wiring note</title>
      <text>&lt;html&gt;&lt;body style='font-family:Arial;font-size:10pt'&gt;&lt;b&gt;POWER / SAFETY - READ BEFORE CONNECTING&lt;/b&gt;&lt;br/&gt;REMOVE CR2032. Wire and check continuity with all power OFF.&lt;br/&gt;White lead = user-reported 3V3 VCC. Uno supply pins are NOT automatically wired in this drawing.&lt;br/&gt;STOP: a 3.3V target cannot take direct 5V Uno ISP signals. Disconnect USB and target power.&lt;br/&gt;Use verified SPI level translation or a voltage-compatible ISP host before reconnecting (not shown).&lt;br/&gt;Uno 3V3 power does NOT change its I/O levels. Do not join supply outputs.&lt;br/&gt;Colours match the user&amp;#x27;s reported COM6 harness; continuity and programming are not yet verified.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="15" y="710" z="6" width="1250" height="190"/>
        </breadboardView>
        <schematicView layer="schematicNote">
          <geometry x="15" y="710" z="6" width="1250" height="190"/>
        </schematicView>
      </views>
    </instance>
    <instance moduleIdRef="NoteModuleID" modelIndex="903" path="note.fzp">
      <title>Wiring note</title>
      <text>&lt;html&gt;&lt;body style='font-family:Arial;font-size:10pt'&gt;&lt;b&gt;BLACK inter-jaw lead is essential.&lt;/b&gt;&lt;br/&gt;J1.6 -&gt; probe J2 -&gt; insulated slack wire -&gt; anvil J1 -&gt; P8 / P8L+P8R -&gt; front TP8.&lt;br/&gt;Fence and lower guide are mechanical; do not populate their header.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="790" y="595" z="6" width="460" height="105"/>
        </breadboardView>
        <schematicView layer="schematicNote">
          <geometry x="790" y="595" z="6" width="460" height="105"/>
        </schematicView>
      </views>
    </instance>
  </instances>
</module>
