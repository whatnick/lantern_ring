(text "One RGBW package: independent dice, common anodes on PCB" (at 119.38 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "c92d3de1-ede5-501d-b974-b2f643b18b7f"))
(text "PB3: OPEN = high / CLOSED = low; latch before PWM" (at 200.66 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a457f1e2-66f4-5b72-b762-a983d80649da"))
(text "LOCKED IR CONTACTS: no header needed on ring" (at 299.72 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9c85b9ac-b39f-55ff-9619-bf44b6bd9658"))
(text "R / PB0 / OC0A" (at 30.48 119.38 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "88c4cc56-ece7-5dad-9ead-5e58937b3587"))
(text "G / PB1 / OC0B" (at 121.92 119.38 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "db5cade4-b839-5df9-8d73-54b632e81026"))
